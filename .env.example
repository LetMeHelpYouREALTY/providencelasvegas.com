# Providence Las Vegas Real Estate – Environment Variables
# Copy to .env.local for local dev. Add to Vercel for production.

# Google Maps Platform (required for map embeds, directions, amenities)
# Get key: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Maps Embed API, Maps JavaScript API, Places API (New), Directions API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: Place ID for Providence Real Estate so the embed highlights this business (not another at same address).
# Get: https://developers.google.com/maps/documentation/places/web-service/place-id (search your business) or from GBP.
# NEXT_PUBLIC_GOOGLE_MAPS_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Search Console verification
# Get: https://search.google.com/search-console → Add property → HTML tag
# Use only the content value (the code inside content="..."), not the full meta tag
GOOGLE_SITE_VERIFICATION=your_verification_code

# Cloudflare Images (hosted storage + imagedelivery.net). Git copies in
# public/images/generated are the backup until `npm run images:cloudflare` writes IDs.
# Do not orange-cloud www — Vercel is origin. A dedicated images hostname on Cloudflare is OK.
# Account ID and hash are public. Never commit CLOUDFLARE_API_TOKEN.
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
# CLOUDFLARE_API_TOKEN=
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ACCOUNT_HASH=byE6BTe9lNqo21V57n4aPQ
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_BASE_URL=https://images.providencelasvegas.com
NEXT_PUBLIC_CLOUDFLARE_IMAGES_VARIANT=public
